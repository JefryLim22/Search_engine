# ==========================================================
#  .env PRODUKSI — salin ke .env lalu sesuaikan semua nilai.
#      cp .env.production.example .env && nano .env
#  JANGAN commit .env ke git (sudah di .gitignore).
# ==========================================================

# --- Server ---
PORT=4000
NODE_ENV=production
# Sama-origin: Express menyajikan dist/ + API dari domain yang sama,
# jadi KOSONGKAN (atau isi domain publik Anda). JANGAN pakai localhost:5173
# di produksi, nanti cookie login admin gagal.
CORS_ORIGIN=

# --- Meilisearch ---
# Meilisearch jalan lokal di server, jangan diekspos ke publik.
MEILI_HOST=http://127.0.0.1:7700
# WAJIB ganti: key panjang & acak. Harus SAMA dengan MEILI_MASTER_KEY
# yang dipakai saat menjalankan Meilisearch.
MEILI_MASTER_KEY=GANTI-DENGAN-KEY-PANJANG-ACAK-MINIMAL-32-KARAKTER
MEILI_INDEX=pages

# --- Admin panel auth ---
ADMIN_USERNAME=admin
# Untuk produksi: JANGAN pakai password plaintext. Kosongkan ADMIN_PASSWORD
# dan isi ADMIN_PASSWORD_HASH dengan bcrypt hash (lihat DEPLOY_AAPANEL.md
# untuk cara generate). Kalau ADMIN_PASSWORD_HASH diisi, ADMIN_PASSWORD diabaikan.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# --- JWT secret (untuk cookie sesi admin) ---
# Ganti dengan string acak panjang. Generate:  openssl rand -hex 32
JWT_SECRET=GANTI-DENGAN-STRING-ACAK-PANJANG
