# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Meilisearch
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-master-key
MEILI_INDEX=products

# Admin panel auth
ADMIN_USERNAME=admin
# For quick start you can use a plaintext password (dev only):
ADMIN_PASSWORD=admin123
# For production, generate a bcrypt hash and set ADMIN_PASSWORD_HASH instead
# (leave ADMIN_PASSWORD empty when using a hash):
ADMIN_PASSWORD_HASH=

# JWT secret used to sign admin session cookies
JWT_SECRET=change-me-to-a-long-random-string
